# =============================================================================
# Copy file này thành .env rồi điền giá trị thật.
#   cp _env.example .env
#
# .env KHÔNG BAO GIỜ được commit (đã có trong .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# LLM - Google Gemini
# -----------------------------------------------------------------------------

# Lấy key tại: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=

# CẢNH BÁO 1: tên model Gemini thay đổi liên tục. Tính tới 07/2026, cả
#   gemini-2.5-flash và gemini-2.5-flash-lite đều đã trả 404 với user mới.
#
# CẢNH BÁO 2: KHÔNG dùng alias "-latest" (vd: gemini-flash-lite-latest).
#   Alias tự hot-swap sang model mới mỗi lần Google release -> số liệu
#   benchmark trong báo cáo sẽ không tái lập được. Luôn pin model stable.
#
# Chạy `python -m tools.probe_gemini` để xem key của bạn dùng được model nào.
GEMINI_MODEL=gemini-3.1-flash-lite

# Parse câu lệnh thành JSON là bài toán deterministic -> để 0.
GEMINI_TEMPERATURE=0

# Tắt "thinking" để cắt latency.
# Bài toán này không cần suy luận sâu; thinking mặc định đẩy latency lên
# hàng chục giây và gây 504 DEADLINE_EXCEEDED.
#   Gemini 3.x : minimal | low | medium | high  (để rỗng = mặc định của model)
#   Gemini 2.5 : thinking_budget, 0 = tắt
GEMINI_THINKING_LEVEL=minimal
GEMINI_THINKING_BUDGET=0

# Ép model trả đúng JSON schema (enum sinh từ device_registry.json).
# Nếu model không hỗ trợ, hệ thống tự hạ cấp config - không cần tắt tay.
GEMINI_STRUCTURED_OUTPUT=true


# -----------------------------------------------------------------------------
# LLM - độ bền
# -----------------------------------------------------------------------------

# Timeout mỗi lần gọi LLM (giây).
LLM_TIMEOUT_SECONDS=15

# Số lần thử LẠI sau lần đầu thất bại. 2 = tối đa 3 lần gọi.
# Gemini trả 503 (quá tải) khá thường xuyên nên để 2.
LLM_MAX_RETRIES=2

# Backoff giữa các lần thử lại (giây), tăng gấp đôi: 0.5 -> 1.0 -> 2.0
LLM_RETRY_BACKOFF_SECONDS=0.5

# true  = luôn dùng mock parser (chạy offline, không tốn quota, dùng cho test)
# false = dùng Gemini thật
#
# LƯU Ý: để true thì GEMINI_API_KEY bị bỏ qua hoàn toàn.
USE_MOCK_LLM=false


# -----------------------------------------------------------------------------
# Face recognition
# -----------------------------------------------------------------------------

ENABLE_FACE_AUTH=false
FACE_AUTH_THRESHOLD=0.80 # Ngưỡng tin cậy để chấp nhận một khuôn mặt (0.0 - 1.0).
FACE_REQUIRE_BLINK=true
CAMERA_INDEX=0

# --- Speech-to-Text ---
ENABLE_STT=false
# Để trống dùng model gốc; trỏ vào checkpoint đã fine-tune để so sánh:
# PHOWHISPER_MODEL=./models/phowhisper-finetuned
PHOWHISPER_MODEL=vinai/PhoWhisper-base

# true -> MockFaceRecognizer: LUÔN nhận ra "member_1", không cần camera/model.
# CẢNH BÁO: bật ở môi trường thật = ai đứng trước máy cũng mở được cửa.
USE_MOCK_FACE=false

# Bắt chớp mắt trước khi chốt khung hình (chống giơ ảnh in ra trước camera).
FACE_REQUIRE_BLINK=true

# Thời gian tối đa chờ tìm thấy khuôn mặt trước khi bỏ cuộc (giây).
FACE_SCAN_TIMEOUT_SECONDS=15


# -----------------------------------------------------------------------------
# Speech-to-Text
# -----------------------------------------------------------------------------

# true -> MockSTTStrategy: trả transcript đặt sẵn, KHÔNG tải model.
# Để true khi chỉ test luồng text, tránh tải PhoWhisper (~1GB) không cần thiết.
USE_MOCK_STT=false

# Model PhoWhisper trên HuggingFace. "base" đủ nhanh trên CPU.
PHOWHISPER_MODEL=vinai/PhoWhisper-base

# Số giây ghi âm mỗi lượt ở chế độ console giọng nói.
VOICE_RECORD_SECONDS=4.0


# -----------------------------------------------------------------------------
# Hardware - Adafruit IO
# -----------------------------------------------------------------------------

# simulation -> giữ trạng thái trong RAM, KHÔNG nối MQTT (chạy được offline).
# real       -> subscribe feed cảm biến của Yolo:Bit và publish lệnh xuống.
HARDWARE_MODE=simulation

ADAFRUIT_IO_USERNAME=
ADAFRUIT_IO_KEY=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# CẢNH BÁO: bật cờ này sẽ XÓA TRẮNG database/yolohome.db mỗi lần init_db()
# được gọi — kể cả khi RuleService khởi tạo. Chỉ dùng để reset thủ công.
# Test nên monkeypatch DB_PATH sang tmp_path thay vì dùng cờ này.
# YOLOHOME_RESET_DB=0

# -----------------------------------------------------------------------------
# Web dashboard
# -----------------------------------------------------------------------------

FLASK_ENV=development
