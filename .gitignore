# =========================
# Python cache / build
# =========================
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/

# =========================
# Environment variables / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Database files
# =========================
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
database/*.sqlite3

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# AI models / weights / large binary files
# =========================
models/*
!models/.gitkeep

*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth
*.bin
*.safetensors

# =========================
# Dataset / audio / snapshots
# Keep folder structure, ignore actual large/private data
# =========================
data/*
!data/.gitkeep
!data/sample/
data/sample/*
!data/sample/.gitkeep

*.wav
*.mp3
*.flac
*.m4a

# Optional dataset folders
data/audio/
data/face_dataset/
data/snapshots/

# =========================
# Test / coverage cache
# =========================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================
# IDE / OS files
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db